{
  "name": "AgentTask",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "title": "Agent ID"
    },
    "target_outlet": {
      "type": "string",
      "title": "Target Outlet"
    },
    "business_info": {
      "type": "string",
      "title": "Business Info (JSON)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "result": {
      "type": "string",
      "title": "Result"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agent_id",
    "target_outlet"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}