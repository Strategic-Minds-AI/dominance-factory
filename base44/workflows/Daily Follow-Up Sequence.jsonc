{
  "description": "Processes scheduled follow-ups \u2014 sends email/SMS to contacts with due follow-up dates",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_follow_up",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_followups": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyFollowUp",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Process follow-ups",
            "description": "Sends due follow-up messages to contacts"
          }
        }
      }
    ]
  },
  "name": "Daily Follow-Up Sequence",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}