{
  "description": "Drains the page generation queue every 10 minutes \u2014 keeps programmatic SEO pipeline running",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "queue_drain",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "drain_queue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processGenerationQueue",
            "args": {
              "batch_size": 10
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Drain generation queue",
            "description": "Processes up to 10 pages per run"
          }
        }
      }
    ]
  },
  "name": "Generation Queue Drain",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}